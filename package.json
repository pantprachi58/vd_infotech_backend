{
  "name": "vd-infotech-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Blog API for the VD Infotech website",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "seed:fresh": "node --env-file-if-exists=.env src/seed/seed.js --fresh"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.10",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.1"
  }
}
