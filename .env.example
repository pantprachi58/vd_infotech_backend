# Port the API listens on.
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/vdinfotech

# Origins allowed by CORS (comma-separated). The Next.js site fetches from the
# server, so this only matters for browser clients such as an admin panel.
CORS_ORIGINS=http://localhost:3000

# Required in the `x-api-key` header for every create / update / delete call.
# Use a long random string in production.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional: after every write the API asks the website to refresh its cached
# blog pages. Leave empty to rely on the site's 60-second revalidation instead.
FRONTEND_REVALIDATE_URL=http://localhost:3000/app-api/revalidate
REVALIDATE_SECRET=change-me-too

# SMTP for the consultation (strategy session) form. Never commit real values.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=consultancy@example.com
# SMTP_PASS=
# SMTP_FROM="vdinfotech<consultancy@example.com>"
# Where consultation requests are sent (defaults to SMTP_USER).
# CONSULTATION_TO=
# --- SMTP ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=consultancy@vdinfotech.in
SMTP_PASS=Prachi@11@11
SMTP_FROM="vdinfotech <consultancy@vdinfotech.in>"
SMTP_USER=vdlead@vdinfotech.in
SMTP_PASS=Prachi@11@11
SMTP_LEADFROM="vdinfotech <Vdlead@vdinfotech.in>"