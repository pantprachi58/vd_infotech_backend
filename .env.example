# Port the API listens on.
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/vdinfotech

# Origins allowed by CORS (comma-separated). The Next.js site fetches from the
# server, so this only matters for browser clients such as an admin panel.
CORS_ORIGINS=http://localhost:3000

# Required in the `x-api-key` header for every create / update / delete call.
# Use a long random string in production.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional: after every write the API asks the website to refresh its cached
# blog pages. Leave empty to rely on the site's 60-second revalidation instead.
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-too

# Razorpay (Dashboard → Account & Settings → API Keys). Test keys start with
# rzp_test_. Never commit real values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when creating the webhook (Dashboard → Webhooks), for
# POST <this API's public URL>/api/payments/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Optional: how long an auto-renewing subscription runs, in months (default 60).
# SUBSCRIPTION_TERM_MONTHS=60
