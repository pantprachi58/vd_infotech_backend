# Port the API listens on.
PORT=5000

# MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/vdinfotech

# Origins allowed by CORS (comma-separated). The Next.js site fetches from the
# server, so this only matters for browser clients such as an admin panel.
CORS_ORIGINS=http://localhost:3000

# Required in the `x-api-key` header for every create / update / delete call.
# Use a long random string in production.
ADMIN_API_KEY=change-me-to-a-long-random-string

# Optional: after every write the API asks the website to refresh its cached
# blog pages. Leave empty to rely on the site's 60-second revalidation instead.
FRONTEND_REVALIDATE_URL=http://localhost:3000/app-api/revalidate
REVALIDATE_SECRET=change-me-too

# --- Email (Hostinger SMTP) ---------------------------------------------------
# Every mailbox shares one SMTP server. Port 465 = SSL (SMTP_SECURE=true);
# port 587 = STARTTLS (SMTP_SECURE=false). Never commit real passwords.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true

# Each mailbox: <PREFIX>_SMTP_USER / _SMTP_PASS log in, _SMTP_FROM is the From
# header, _MAIL_TO is the inbox that receives the form (comma-separated;
# defaults to _SMTP_USER). The visitor's confirmation is sent from the same box.

# Lead — "Let's Get Your Project Started" popup, header "Book an Appointment",
# hero CTA buttons and "Pick a Time" (free strategy call).
LEAD_SMTP_USER=lead@example.com
LEAD_SMTP_PASS=
LEAD_SMTP_FROM="VD Infotech <lead@example.com>"
LEAD_MAIL_TO=lead@example.com

# Consult — "Book Your Strategy Session" (Personalized Growth Consultation).
CONSULT_SMTP_USER=consultancy@example.com
CONSULT_SMTP_PASS=
CONSULT_SMTP_FROM="VD Infotech <consultancy@example.com>"
CONSULT_MAIL_TO=consultancy@example.com

# Form — "Start My Growth Journey" (closing CTA band).
FORM_SMTP_USER=form@example.com
FORM_SMTP_PASS=
FORM_SMTP_FROM="VD Infotech <form@example.com>"
FORM_MAIL_TO=form@example.com

# Career — reserved for the careers / job-application forms.
CAREER_SMTP_USER=career@example.com
CAREER_SMTP_PASS=
CAREER_SMTP_FROM="VD Infotech Careers <career@example.com>"
CAREER_MAIL_TO=career@example.com

# Optional: public site URL used in email links, and a PNG/JPG logo for the
# email header (most mail clients don't show SVG). Unset = text wordmark.
# SITE_URL=https://www.vdinfotech.in
# MAIL_LOGO_URL=https://www.vdinfotech.in/images/email-logo.png

# Where links to files attached to forms point (stored in uploads/forms).
# Default: <SITE_URL>/media/forms, which the website rewrites to this API.
# FORM_FILES_URL=https://www.vdinfotech.in/media/forms
